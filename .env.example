# Modèle de fichier d'environnement (développement). Ne JAMAIS versionner de vraies valeurs.
# Sur le VPS, deux fichiers (voir deploy/INSTALL-VPS.md) :
#   /etc/jalonia/jalonia.env       — tout SAUF DATABASE_URL_PROPRIETAIRE ; lisible par root seulement (systemd) ;
#   /etc/jalonia/proprietaire.env  — DATABASE_URL_PROPRIETAIRE seule ; lisible par root et le compte « jalonia ».

# Connexion de l'APPLICATION (rôle PostgreSQL jalonia_app : droits limités, pas de création de schéma).
DATABASE_URL=postgresql://jalonia_app:MOT_DE_PASSE_APP@127.0.0.1:5432/jalonia

# Connexion PROPRIÉTAIRE (rôle jalonia_owner) : migrations et création d'un superadmin uniquement
# (scripts/migrer.ts, scripts/creer-superadmin.ts). L'application en service ne la lit pas.
DATABASE_URL_PROPRIETAIRE=postgresql://jalonia_owner:MOT_DE_PASSE_PROPRIETAIRE@127.0.0.1:5432/jalonia

# Auth.js : secret de signature des sessions (générer avec : openssl rand -base64 48).
AUTH_SECRET=A_GENERER
# Adresse publique de l'application (derrière Caddy).
AUTH_URL=https://jalonia.mosa-apps.com
AUTH_TRUST_HOST=true

# Sessions : inactivité maximale (minutes) et durée maximale d'une session (heures).
SESSION_INACTIVITE_MINUTES=120
SESSION_DUREE_HEURES=8

# Fuseau horaire d'affichage des dates (nom IANA : Africa/Libreville, Africa/Douala, Europe/Paris…).
FUSEAU_HORAIRE=UTC

# Clé de chiffrement des seconds facteurs (32 octets en base64 : openssl rand -base64 32). Obligatoire pour que les
# superadmins puissent se connecter à l'interface. À conserver en lieu sûr : sans elle, chaque second facteur doit
# être réinitialisé.
CLE_SECOND_FACTEUR=

# Envoi SMTP transactionnel (exemple Brevo : hôte smtp-relay.brevo.com, port 587, clé SMTP comme mot de passe).
# Laisser les quatre paramètres vides pour garder les notifications uniquement dans l'application.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=
