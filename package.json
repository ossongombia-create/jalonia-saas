{
  "name": "jalonia-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Jalonia — application multi-organisations de documentation selon le langage Qualigramme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copier-editeur.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copier-editeur.mjs",
    "build": "next build",
    "postbuild": "node scripts/construire-taches.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:editeur && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && node tests/e2e/lancer.mjs",
    "test:bpmn": "node tests/bpmn/exporter-exemples.mjs && python3 tests/bpmn/valider_xsd.py tests/bpmn/.sortie editeur/tests/fixtures/autre-outil.bpmn && node tests/bpmn/ouvrir-bpmn-js.cjs",
    "db:migrate": "tsx scripts/migrer.ts",
    "superadmin:creer": "tsx scripts/creer-superadmin.ts",
    "test:editeur": "node --test \"editeur/tests/*.test.mjs\""
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.1.7",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bpmn-js": "18.29.1",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "1.56.0",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
