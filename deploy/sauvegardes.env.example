# Modèle pour /etc/jalonia/sauvegardes.env (droits root:root 600); ne jamais mettre de vraies valeurs dans Git.
# Bucket Cloudflare R2 dédié, accès « Object Read & Write » limité à ce seul bucket.
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/jalonia
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# Générer une phrase secrète aléatoire et en conserver une copie hors VPS : sans elle, le dépôt est irrécupérable.
RESTIC_PASSWORD=<SECRET_RESTIC_A_CONSERVER_HORS_VPS>
